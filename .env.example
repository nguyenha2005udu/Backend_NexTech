# NexTech — biến môi trường mẫu. Chỉ một file .env cho cả dự án, đặt ở thư mục gốc (cạnh docker-compose.yml).
# `docker compose up` chạy được KHÔNG cần file .env: mọi giá trị dưới đây đã là mặc định trong docker-compose.yml,
# trừ biến ghi [chưa có trong compose] — service đó chưa code, thêm vào docker-compose.yml theo task của nó.
# Chỉ tạo .env (đã bị .gitignore) khi muốn ghi đè: `cp .env.example .env`, rồi sửa. Để trống một biến = dùng mặc định.
# Không bao giờ commit giá trị thật (standards/security-policy.md §1).
# Giá trị là địa chỉ NHÌN TỪ TRONG CONTAINER (postgres:5432, redis:6379), không phải cổng mở ra máy (5433, 6380).

# ── Database (dùng chung cho mọi service) ───────────────────────
# PORT, DB_USER, DB_PASS, DB_NAME riêng từng service (ADR-0003: mỗi service một database), cố định trong docker-compose.yml:
#   identity  PORT=3001 DB_USER=identity_user  DB_PASS=identity_pass  DB_NAME=identity_db
#   catalog   PORT=3002 DB_USER=catalog_user   DB_PASS=catalog_pass   DB_NAME=catalog_db
#   promotion PORT=3003 DB_USER=promotion_user DB_PASS=promotion_pass DB_NAME=promotion_db
#   order        PORT=3004 DB_USER=order_user        DB_PASS=order_pass        DB_NAME=order_db
#   notification PORT=3006 DB_USER=notification_user DB_PASS=notification_pass DB_NAME=notification_db
#   assistant    PORT=3007 DB_USER=assistant_user    DB_PASS=assistant_pass    DB_NAME=assistant_db
#   (database và user của cả 6 service đã tạo sẵn ở infra/postgres/init-databases.sh)
# Không đặt DB_USER/DB_PASS/DB_NAME ở đây: một .env chung sẽ làm mọi service dùng chung một database.
#
# Docker dùng DB CLOUD (mỗi service một DB riêng): đặt trong .env (đã ignore, KHÔNG đặt ở file này) theo mẫu
# <SERVICE>_DB_*, SERVICE là IDENTITY, CATALOG, PROMOTION, ORDER, NOTIFICATION, ASSISTANT. Giá trị lấy như
# services/<service>/.env.local của npm run dev. Service nào không đặt thì vẫn dùng Postgres trong Docker.
#   ORDER_DB_HOST=<host cloud>   ORDER_DB_PORT=5432   ORDER_DB_SSL=true
#   ORDER_DB_USER=<user>         ORDER_DB_PASS=<mật khẩu>   ORDER_DB_NAME=<tên db>
# Thiếu <SERVICE>_DB_HOST/PORT/SSL thì dùng DB_HOST/DB_PORT/DB_SSL bên dưới. Đặt DB_HOST cloud mà không đặt
# <SERVICE>_DB_USER/PASS thì container đăng nhập cloud bằng mật khẩu dev → lỗi (gotchas.md).
# Tương tự, URL service nội bộ (*_SERVICE_URL), REDIS_DB của order (=1) và WEBHOOK_URL của payos-mock ghi cứng trong docker-compose.yml.
# Chạy ngoài Docker (test:int, migration:generate) thì truyền trên dòng lệnh, ví dụ:
#   DB_HOST=localhost DB_PORT=5433 DB_USER=catalog_user DB_PASS=catalog_pass DB_NAME=catalog_db DB_SSL=false
DB_HOST=postgres
DB_PORT=5432
# be/ mặc định bật SSL (DB cloud). Postgres trong compose không có SSL
DB_SSL=false
# true: in mọi câu SQL, dùng để đếm số truy vấn mỗi endpoint (non-functional-standards §1)
DB_LOGGING=false
# Mật khẩu superuser Postgres (chỉ dev)
POSTGRES_PASSWORD=postgres

# ── CẤU HÌNH FPT AI MARKETPLACE (AI CHAT) - https://mkp-api.fptcloud.com ──
# assistant-service (design/ASSISTANT/README.md §4), chưa có trong docker-compose.yml.
# Tên biến theo code be/src/config/configuration.ts: FPT_KEY (be/.env cũ khai FPT_API_KEY nhưng code không đọc biến đó)
FPT_KEY=dev
FPT_MODEL=DeepSeek-V4-Flash
# Mặc định gọi infra/ai-mock. Dịch vụ thật: https://mkp-api.fptcloud.com (ADR-0013)
FPT_BASE_URL=http://ai-mock:4020

# ── CẤU HÌNH GỬI MAIL (identity; notification dùng chung) ───────
# Mặc định Mailpit (xem thư ở http://localhost:8025). Gmail thật: MAIL_HOST=smtp.gmail.com MAIL_PORT=587,
# MAIL_USER=<địa chỉ gmail>, MAIL_PASS=<app password>, MAIL_REQUIRE_TLS=true
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=no-reply@nextech.local
MAIL_PASS=dev
MAIL_REQUIRE_TLS=false

# ── CẤU HÌNH JWT (identity ký, gateway kiểm) ────────────────────
JWT_SECRET=dev-access-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ── CẤU HÌNH SOCIAL LOGIN (OAUTH 2.0) ───────────────────────────
# Ứng dụng Google/Facebook thật (không commit). Để "dev" thì nút đăng nhập mạng xã hội không dùng được, phần khác chạy bình thường.
# Callback đi qua gateway (cổng 8080), không gọi thẳng identity
GOOGLE_CLIENT_ID=dev
GOOGLE_CLIENT_SECRET=dev
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

FACEBOOK_APP_ID=dev
FACEBOOK_APP_SECRET=dev
FACEBOOK_CALLBACK_URL=http://localhost:8080/api/auth/facebook/callback

# Trang web nhận redirect sau OAuth (web)
REDIRECT_URI=http://localhost:3000

# ── CẤU HÌNH REDIS ──────────────────────────────────────────────
# Một container dùng chung: identity (OTP, refresh token) ở DB 0; order (hạn giữ hàng, khoá đơn — ADR-0015) ở DB 1,
# REDIS_DB=1 ghi cứng trong khối order-service của docker-compose.yml, không đặt ở đây.
# Redis cloud (Upstash): đặt host, port, password, REDIS_TLS=true.
# Chạy test:int ngoài Docker: REDIS_HOST=localhost REDIS_PORT=6380 trên dòng lệnh (cổng chỉ mở ở 127.0.0.1)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# Client Redis của order phải lỗi nhanh để khoá đơn fail-open (NT.ORDER_HOLD §2) [chưa có trong compose]
REDIS_COMMAND_TIMEOUT_MS=200
REDIS_CONNECT_TIMEOUT_MS=1000

# ── PAYOS (order-service, design/ORDER/NT.PAYMENT/API_Spec.md §5) ──
# Mặc định dùng infra/payos-mock. Compose truyền các biến này cho order-service (T3.6), PAYOS_CHECKSUM_KEY cho cả payos-mock
PAYOS_CLIENT_ID=dev
PAYOS_API_KEY=dev
# Phải trùng với payos-mock vì mock dùng khoá này để ký webhook
PAYOS_CHECKSUM_KEY=dev-checksum
PAYOS_RETURN_URL=http://localhost:3000/payment/success
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel
# SDK đọc biến này. Compose mặc định mock; muốn gọi PayOS thật thì đặt https://api-merchant.payos.vn tường minh
PAYOS_BASE_URL=http://payos-mock:4010
# Truyền vào new PayOS({ timeout, maxRetries: 0 })
PAYOS_TIMEOUT_MS=5000

# ── CLOUDINARY (catalog, design/CATALOG/NT.CATALOG/API_Spec.md §5) ──
# Key thật (không commit). Để "disabled": upload file trả 503 NT-GEN-0503, nhập URL ảnh vẫn dùng được
CLOUDINARY_CLOUD_NAME=disabled
CLOUDINARY_API_KEY=disabled
CLOUDINARY_API_SECRET=disabled

# ════ Biến riêng của kiến trúc microservice (be/ không có) ═════════

# ── Dùng chung (architecture.md §8) ─────────────────────────────
INTERNAL_API_TOKEN=dev-internal-token
HTTP_TIMEOUT_MS=2000
HTTP_RETRIES=2
# false để đo số liệu "trước khi xử lý" trong thí nghiệm
RESILIENCE_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
SEED_DEMO=true
# Circuit breaker của ResilientHttpClient (reliability-standard §5)
CB_VOLUME_THRESHOLD=5
CB_ERROR_PERCENT=50
CB_RESET_MS=10000

# ── API Gateway (design/SHARED/NT.GATEWAY/API_Spec.md §6) ───────
# Phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000
# true khi chạy HTTPS (gateway, identity, assistant)
COOKIE_SECURE=false
PROXY_TIMEOUT_MS=10000
# Phải lớn hơn ngân sách AI của assistant (75 s), nhỏ hơn timeout 90 s của app
PROXY_TIMEOUT_AI_MS=80000
# Theo IP, mỗi phút. Đặt 0 để tắt khi đo tải
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=30
RATE_LIMIT_AI_PER_MIN=20

# ── Identity: gợi ý địa chỉ (design/IDENTITY/NT.PLACE/API_Spec.md) [chưa có trong compose] ──
PHOTON_BASE_URL=https://photon.komoot.io
PHOTON_TIMEOUT_MS=3000

# ── Catalog: theo dõi giá (design/CATALOG/NT.CATALOG/API_Spec.md §5) [chưa có trong compose] ──
# Đặt "*/1 * * * *" khi demo
PRICE_ALERT_CRON="*/10 * * * *"

# ── Outbox và consumer (design/SHARED/NT.MESSAGING/API_Spec.md §6) [chưa có trong compose] ──
# order, catalog phát sự kiện; notification nhận. RABBITMQ_URL ở mục "Dùng chung"
OUTBOX_POLL_MS=2000
OUTBOX_BATCH=50
OUTBOX_RETENTION_DAYS=7
CONSUMER_MAX_ATTEMPTS=3
CONSUMER_PREFETCH=10

# ── Order: giá, saga (design/ORDER/NT.ORDER/API_Spec.md §4) ──
# Có trong compose (có mặc định, không bắt buộc): 4 biến đầu từ T3.3, SAGA_RECONCILE_INTERVAL_MS từ T3.5
# BR-04: phí ship, miễn phí khi tiền hàng từ ngưỡng
SHIPPING_FEE=30000
FREE_SHIPPING_THRESHOLD=500000
# Ngân sách trong request; quá thì trả 202
SAGA_BUDGET_MS=8000
# Quá hạn thì hoàn tác
SAGA_DEADLINE_MS=120000
# Chu kỳ cron đối soát (RESILIENCE_ENABLED=false thì cron tắt)
SAGA_RECONCILE_INTERVAL_MS=10000

# ── Order: hạn giữ hàng, khoá đơn (design/ORDER/NT.ORDER_HOLD/API_Spec.md §5, ADR-0015) [chưa có trong compose] ──
# BR-19: 15 phút giữ hàng chờ thanh toán; đặt 60000 khi kiểm chứng nhanh
ORDER_HOLD_TTL_MS=900000
ORDER_HOLD_GRACE_MS=60000
ORDER_HOLD_SWEEP_INTERVAL_MS=15000
ORDER_HOLD_DB_SWEEP_EVERY=20
ORDER_HOLD_BATCH=50
ORDER_HOLD_DEFER_BACKOFF_MS=60000
ORDER_HOLD_MAX_DEFER_MS=600000
# BR-20: ORDER_LOCK_WAIT_MS + DB_LOCK_TIMEOUT_MS ≤ 3000
ORDER_LOCK_TTL_MS=10000
ORDER_LOCK_WAIT_MS=2000
ORDER_LOCK_RETRY_MS=50
# Chỉ áp cho kết nối ứng dụng của order_db, không áp cho migration
DB_LOCK_TIMEOUT_MS=1000
DB_IDLE_TX_TIMEOUT_MS=15000

# ── Assistant: gọi AI (design/ASSISTANT/README.md §4) [chưa có trong compose] ──
# FPT_KEY, FPT_MODEL, FPT_BASE_URL ở mục FPT AI phía trên; COOKIE_SECURE dùng chung với gateway
AI_CALL_TIMEOUT_MS=30000
# Phải nhỏ hơn PROXY_TIMEOUT_AI_MS của gateway
AI_BUDGET_MS=75000
AI_CONTEXT_TTL_MS=300000

# ── Thêm theo task ───────────────────────────────────────────────
# Khi thêm biến vào docker-compose.yml: bỏ nhãn [chưa có trong compose] ở biến đó trong cùng commit.
# Biến mới chưa có ở đây thì thêm ở đây trong cùng commit.
