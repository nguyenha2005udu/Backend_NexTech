# NexTech — biến môi trường mẫu.
# `docker compose up` chạy được KHÔNG cần file .env: mọi giá trị dưới đây đã là mặc định trong docker-compose.yml.
# Chỉ tạo .env (đã bị .gitignore) khi muốn ghi đè. Không bao giờ commit giá trị thật (standards/security-policy.md §1).

# ── Dùng chung (architecture.md §8) ─────────────────────────────
INTERNAL_API_TOKEN=dev-internal-token
JWT_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
HTTP_TIMEOUT_MS=2000
HTTP_RETRIES=2
# false để đo số liệu "trước khi xử lý" trong thí nghiệm
RESILIENCE_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
SEED_DEMO=true
# Circuit breaker của ResilientHttpClient (reliability-standard §5)
CB_VOLUME_THRESHOLD=5
CB_ERROR_PERCENT=50
CB_RESET_MS=10000

# ── Hạ tầng ─────────────────────────────────────────────────────
# Mật khẩu superuser Postgres (chỉ dev). User từng service: <svc>_user / <svc>_pass (infra/postgres/init-databases.sh)
POSTGRES_PASSWORD=postgres

# ── PayOS (mặc định dùng infra/payos-mock) ──────────────────────
PAYOS_CHECKSUM_KEY=dev-checksum

# ── Thêm theo task: gateway (T1.4), từng service (Phase 2–4, 8) ──
# Khi thêm biến mới vào docker-compose.yml, thêm ở đây trong cùng commit.
