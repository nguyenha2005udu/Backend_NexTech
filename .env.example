# NexTech — biến môi trường mẫu. Chỉ một file .env cho cả dự án, đặt ở thư mục gốc (cạnh docker-compose.yml).
# `docker compose up` chạy được KHÔNG cần file .env: mọi giá trị dưới đây đã là mặc định trong docker-compose.yml.
# Chỉ tạo .env (đã bị .gitignore) khi muốn ghi đè: `cp .env.example .env`, rồi sửa. Để trống một biến = dùng mặc định.
# Không bao giờ commit giá trị thật (standards/security-policy.md §1).
# Giá trị là địa chỉ NHÌN TỪ TRONG CONTAINER (postgres:5432, redis:6379), không phải cổng mở ra máy (5433, 6380).

# ── Database (dùng chung cho mọi service) ───────────────────────
# PORT, DB_USER, DB_PASS, DB_NAME riêng từng service (ADR-0003: mỗi service một database), cố định trong docker-compose.yml:
#   identity  PORT=3001 DB_USER=identity_user  DB_PASS=identity_pass  DB_NAME=identity_db
#   catalog   PORT=3002 DB_USER=catalog_user   DB_PASS=catalog_pass   DB_NAME=catalog_db
#   promotion PORT=3003 DB_USER=promotion_user DB_PASS=promotion_pass DB_NAME=promotion_db
#   order 3004, notification 3006, assistant 3007: thêm theo task (infra/postgres/init-databases.sh)
# Chạy ngoài Docker (test:int, migration:generate) thì truyền trên dòng lệnh, ví dụ:
#   DB_HOST=localhost DB_PORT=5433 DB_USER=catalog_user DB_PASS=catalog_pass DB_NAME=catalog_db DB_SSL=false
DB_HOST=postgres
DB_PORT=5432
# be/ mặc định bật SSL (DB cloud). Postgres trong compose không có SSL
DB_SSL=false
# true: in mọi câu SQL, dùng để đếm số truy vấn mỗi endpoint (non-functional-standards §1)
DB_LOGGING=false
# Mật khẩu superuser Postgres (chỉ dev)
POSTGRES_PASSWORD=postgres

# ── CẤU HÌNH FPT AI MARKETPLACE (AI CHAT) - https://mkp-api.fptcloud.com ──
# assistant-service (design/ASSISTANT/README.md §4), chưa có trong docker-compose.yml.
# Tên biến theo code be/src/config/configuration.ts: FPT_KEY (be/.env cũ khai FPT_API_KEY nhưng code không đọc biến đó)
FPT_KEY=dev
FPT_MODEL=DeepSeek-V4-Flash

# ── CẤU HÌNH GỬI MAIL (identity; notification dùng chung) ───────
# Mặc định Mailpit (xem thư ở http://localhost:8025). Gmail thật: MAIL_HOST=smtp.gmail.com MAIL_PORT=587,
# MAIL_USER=<địa chỉ gmail>, MAIL_PASS=<app password>, MAIL_REQUIRE_TLS=true
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=no-reply@nextech.local
MAIL_PASS=dev
MAIL_REQUIRE_TLS=false

# ── CẤU HÌNH JWT (identity ký, gateway kiểm) ────────────────────
JWT_SECRET=dev-access-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ── CẤU HÌNH SOCIAL LOGIN (OAUTH 2.0) ───────────────────────────
# Ứng dụng Google/Facebook thật (không commit). Để "dev" thì nút đăng nhập mạng xã hội không dùng được, phần khác chạy bình thường.
# Callback đi qua gateway (cổng 8080), không gọi thẳng identity
GOOGLE_CLIENT_ID=dev
GOOGLE_CLIENT_SECRET=dev
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

FACEBOOK_APP_ID=dev
FACEBOOK_APP_SECRET=dev
FACEBOOK_CALLBACK_URL=http://localhost:8080/api/auth/facebook/callback

# Trang web nhận redirect sau OAuth (web)
REDIRECT_URI=http://localhost:3000

# ── CẤU HÌNH REDIS (identity: OTP, refresh token) ───────────────
# Redis cloud (Upstash): đặt host, port, password, REDIS_TLS=true.
# Chạy test:int ngoài Docker: REDIS_HOST=localhost REDIS_PORT=6380 trên dòng lệnh (cổng chỉ mở ở 127.0.0.1)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ── PAYOS (order-service, design/ORDER/NT.PAYMENT/API_Spec.md §5) ──
# Mặc định dùng infra/payos-mock. Hiện compose mới truyền PAYOS_CHECKSUM_KEY cho payos-mock; phần còn lại dùng khi có order-service
PAYOS_CLIENT_ID=dev
PAYOS_API_KEY=dev
# Phải trùng với payos-mock vì mock dùng khoá này để ký webhook
PAYOS_CHECKSUM_KEY=dev-checksum
PAYOS_RETURN_URL=http://localhost:3000/payment/success
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel

# ── CLOUDINARY (catalog, design/CATALOG/NT.CATALOG/API_Spec.md §5) ──
# Key thật (không commit). Để "disabled": upload file trả 503 NT-GEN-0503, nhập URL ảnh vẫn dùng được
CLOUDINARY_CLOUD_NAME=disabled
CLOUDINARY_API_KEY=disabled
CLOUDINARY_API_SECRET=disabled

# ════ Biến riêng của kiến trúc microservice (be/ không có) ═════════

# ── Dùng chung (architecture.md §8) ─────────────────────────────
INTERNAL_API_TOKEN=dev-internal-token
HTTP_TIMEOUT_MS=2000
HTTP_RETRIES=2
# false để đo số liệu "trước khi xử lý" trong thí nghiệm
RESILIENCE_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
SEED_DEMO=true
# Circuit breaker của ResilientHttpClient (reliability-standard §5)
CB_VOLUME_THRESHOLD=5
CB_ERROR_PERCENT=50
CB_RESET_MS=10000

# ── API Gateway (design/SHARED/NT.GATEWAY/API_Spec.md §6) ───────
# Phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000
# true khi chạy HTTPS (gateway và identity)
COOKIE_SECURE=false
PROXY_TIMEOUT_MS=10000
# Phải lớn hơn ngân sách AI của assistant (75 s), nhỏ hơn timeout 90 s của app
PROXY_TIMEOUT_AI_MS=80000
# Theo IP, mỗi phút. Đặt 0 để tắt khi đo tải
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=30
RATE_LIMIT_AI_PER_MIN=20

# ── Thêm theo task: từng service (Phase 2–4, 8) ──────────────────
# Khi thêm biến mới vào docker-compose.yml, thêm ở đây trong cùng commit.
