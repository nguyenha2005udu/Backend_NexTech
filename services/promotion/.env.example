# Biến cho `npm run dev:promotion` (chạy ngoài Docker, scripts/dev.mjs). Chỉ giá trị dev, không có secret thật.
# Ghi đè riêng máy mình: tạo services/promotion/.env.local (đã ignore).
PORT=3003
DB_HOST=127.0.0.1
DB_PORT=5433
DB_SSL=false
DB_USER=promotion_user
DB_PASS=promotion_pass
DB_NAME=promotion_db
DB_LOGGING=false
SEED_DEMO=true
INTERNAL_API_TOKEN=dev-internal-token
RESILIENCE_ENABLED=true
