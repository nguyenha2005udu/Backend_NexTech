# Biến cho `npm run dev:order` (chạy ngoài Docker, scripts/dev.mjs). Chỉ giá trị dev, không có secret thật.
# Ghi đè riêng máy mình: tạo services/order/.env.local (đã ignore).
# Khung T1.6: database. T3.1: URL service. Biến của nghiệp vụ thêm khi code dùng tới.
PORT=3004
DB_HOST=127.0.0.1
DB_PORT=5433
DB_SSL=false
DB_USER=order_user
DB_PASS=order_pass
DB_NAME=order_db
DB_LOGGING=false
IDENTITY_SERVICE_URL=http://127.0.0.1:3001
CATALOG_SERVICE_URL=http://127.0.0.1:3002
PROMOTION_SERVICE_URL=http://127.0.0.1:3003
INTERNAL_API_TOKEN=dev-internal-token
RESILIENCE_ENABLED=true
# T3.3: giá, saga (có mặc định)
SHIPPING_FEE=30000
FREE_SHIPPING_THRESHOLD=500000
SAGA_BUDGET_MS=8000
SAGA_DEADLINE_MS=120000
# T3.5: cron đối soát saga
SAGA_RECONCILE_INTERVAL_MS=10000
# T3.6: PayOS (NT.PAYMENT API_Spec §5). Mặc định payos-mock trong Docker (cổng 4010 mở ra máy).
# THIẾU PAYOS_BASE_URL thì SDK gọi PayOS THẬT. Dùng PayOS thật: đặt https://api-merchant.payos.vn và khoá thật
# trong services/order/.env.local. PAYOS_CHECKSUM_KEY phải trùng khoá payos-mock đang chạy (compose lấy từ .env gốc)
# thì webhook từ mock mới qua được kiểm chữ ký.
PAYOS_BASE_URL=http://127.0.0.1:4010
PAYOS_CLIENT_ID=dev
PAYOS_API_KEY=dev
PAYOS_CHECKSUM_KEY=dev-checksum
PAYOS_RETURN_URL=http://localhost:3000/payment/success
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel
PAYOS_TIMEOUT_MS=5000
