# Biến cho `npm run dev:notification` (chạy ngoài Docker, scripts/dev.mjs). Chỉ giá trị dev, không có secret thật.
# Ghi đè riêng máy mình: tạo services/notification/.env.local (đã ignore).
PORT=3006
DB_HOST=127.0.0.1
DB_PORT=5433
DB_SSL=false
DB_USER=notification_user
DB_PASS=notification_pass
DB_NAME=notification_db
DB_LOGGING=false
INTERNAL_API_TOKEN=dev-internal-token
RESILIENCE_ENABLED=true
# T4.2: email người nhận theo dõi giá (NT.NOTIFICATION API_Spec §5). Chạy ngoài Docker: cổng trên máy
IDENTITY_SERVICE_URL=http://127.0.0.1:3001
# Mailpit (SMTP cổng 1025 mở ra máy, xem thư ở http://localhost:8025)
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USER=no-reply@nextech.local
MAIL_PASS=dev
MAIL_REQUIRE_TLS=false
# T4.2, T4.3: RabbitMQ (cổng 5672 mở ở 127.0.0.1), thử lại và DLQ (NT.MESSAGING API_Spec §6)
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
CONSUMER_MAX_ATTEMPTS=3
CONSUMER_PREFETCH=10
