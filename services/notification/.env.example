# Biến cho `npm run dev:notification` (chạy ngoài Docker, scripts/dev.mjs). Chỉ giá trị dev, không có secret thật.
# Ghi đè riêng máy mình: tạo services/notification/.env.local (đã ignore).
# Khung T1.6: chỉ có database. Biến của nghiệp vụ thêm khi code dùng tới.
PORT=3006
DB_HOST=127.0.0.1
DB_PORT=5433
DB_SSL=false
DB_USER=notification_user
DB_PASS=notification_pass
DB_NAME=notification_db
DB_LOGGING=false
INTERNAL_API_TOKEN=dev-internal-token
RESILIENCE_ENABLED=true
