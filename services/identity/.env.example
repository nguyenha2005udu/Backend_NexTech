# Biến cho `npm run dev:identity` (chạy ngoài Docker, scripts/dev.mjs). Chỉ giá trị dev, không có secret thật.
# Ghi đè riêng máy mình: tạo services/identity/.env.local (đã ignore), ví dụ GOOGLE_CLIENT_ID thật.
# Hạ tầng chạy bằng `npm run dev:infra`: Postgres 127.0.0.1:5433, Redis 127.0.0.1:6380, Mailpit SMTP 127.0.0.1:1025.
# Dùng 127.0.0.1, không dùng localhost: Node phân giải localhost ra ::1 trước, còn Redis, Mailpit chỉ mở IPv4.
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=5433
DB_SSL=false
DB_USER=identity_user
DB_PASS=identity_pass
DB_NAME=identity_db
DB_LOGGING=false
SEED_DEMO=true
INTERNAL_API_TOKEN=dev-internal-token
RESILIENCE_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_TLS=false
# Phải trùng JWT_SECRET của gateway/.env.example
JWT_SECRET=dev-access-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USER=no-reply@nextech.local
MAIL_PASS=dev
MAIL_REQUIRE_TLS=false
# "dev" thì service vẫn chạy nhưng đăng nhập Google/Facebook không dùng được
GOOGLE_CLIENT_ID=dev
GOOGLE_CLIENT_SECRET=dev
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback
FACEBOOK_APP_ID=dev
FACEBOOK_APP_SECRET=dev
FACEBOOK_CALLBACK_URL=http://localhost:8080/api/auth/facebook/callback
REDIRECT_URI=http://localhost:3000
