# Biến cho `npm run dev:catalog` (chạy ngoài Docker, scripts/dev.mjs). Chỉ giá trị dev, không có secret thật.
# Ghi đè riêng máy mình: tạo services/catalog/.env.local (đã ignore).
PORT=3002
DB_HOST=127.0.0.1
DB_PORT=5433
DB_SSL=false
DB_USER=catalog_user
DB_PASS=catalog_pass
DB_NAME=catalog_db
DB_LOGGING=false
SEED_DEMO=true
INTERNAL_API_TOKEN=dev-internal-token
RESILIENCE_ENABLED=true
# disabled: upload file trả 503, nhập URL ảnh vẫn dùng được
CLOUDINARY_CLOUD_NAME=disabled
CLOUDINARY_API_KEY=disabled
CLOUDINARY_API_SECRET=disabled
# Service khác (T2.5). Chạy ngoài Docker: cổng trên máy, như gateway/.env.example
ORDER_SERVICE_URL=http://127.0.0.1:3004
IDENTITY_SERVICE_URL=http://127.0.0.1:3001
# Cron theo dõi giá (mặc định mỗi 10 phút); demo đặt * * * * *
PRICE_ALERT_CRON=*/10 * * * *
