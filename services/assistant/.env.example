# Biến cho `npm run dev:assistant` (chạy ngoài Docker, scripts/dev.mjs). Chỉ giá trị dev, không có secret thật.
# Ghi đè riêng máy mình: tạo services/assistant/.env.local (đã ignore).
# design/ASSISTANT/README.md §4.
PORT=3007
DB_HOST=127.0.0.1
DB_PORT=5433
DB_SSL=false
DB_USER=assistant_user
DB_PASS=assistant_pass
DB_NAME=assistant_db
DB_LOGGING=false
INTERNAL_API_TOKEN=dev-internal-token
RESILIENCE_ENABLED=true
# Tìm sản phẩm (catalog), tên người dùng ở màn quản trị (identity)
CATALOG_SERVICE_URL=http://127.0.0.1:3002
IDENTITY_SERVICE_URL=http://127.0.0.1:3001
# FPT AI. Mặc định ai-mock (docker compose up -d ai-mock). Thật: FPT_BASE_URL=https://mkp-api.fptcloud.com + FPT_KEY.
# FPT_KEY rỗng: gửi tin nhắn trả 503 NT-AST-1003, phần còn lại vẫn chạy.
FPT_BASE_URL=http://127.0.0.1:4020
FPT_KEY=dev
FPT_MODEL=DeepSeek-V4-Flash
# Một lần gọi AI / cả câu trả lời (phải < PROXY_TIMEOUT_AI_MS 80000 của gateway) / giữ danh sách hãng, danh mục
AI_CALL_TIMEOUT_MS=30000
AI_BUDGET_MS=75000
AI_CONTEXT_TTL_MS=300000
# Cookie guest_id của khách. Bật khi chạy HTTPS
COOKIE_SECURE=false
