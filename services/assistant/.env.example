# Biến cho `npm run dev:assistant` (chạy ngoài Docker, scripts/dev.mjs). Chỉ giá trị dev, không có secret thật.
# Ghi đè riêng máy mình: tạo services/assistant/.env.local (đã ignore).
# Khung T1.6: chỉ có database. Biến của nghiệp vụ thêm khi code dùng tới.
PORT=3007
DB_HOST=127.0.0.1
DB_PORT=5433
DB_SSL=false
DB_USER=assistant_user
DB_PASS=assistant_pass
DB_NAME=assistant_db
DB_LOGGING=false
INTERNAL_API_TOKEN=dev-internal-token
RESILIENCE_ENABLED=true
