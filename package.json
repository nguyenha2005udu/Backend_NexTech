{
  "name": "nextech",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "gateway"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "node scripts/dev.mjs",
    "dev:identity": "node scripts/dev.mjs services/identity",
    "dev:catalog": "node scripts/dev.mjs services/catalog",
    "dev:promotion": "node scripts/dev.mjs services/promotion",
    "dev:order": "node scripts/dev.mjs services/order",
    "dev:notification": "node scripts/dev.mjs services/notification",
    "dev:assistant": "node scripts/dev.mjs services/assistant",
    "dev:gateway": "node scripts/dev.mjs gateway",
    "dev:infra": "docker compose --env-file .env.example up -d postgres redis mailpit && docker compose --env-file .env.example stop api-gateway identity-service catalog-service promotion-service order-service notification-service assistant-service",
    "docker:up": "docker compose --env-file .env.example up -d --build",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
