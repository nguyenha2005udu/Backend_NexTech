# Biến cho `npm run dev:gateway` (chạy ngoài Docker, scripts/dev.mjs). Chỉ giá trị dev, không có secret thật.
# Ghi đè riêng máy mình: tạo gateway/.env.local (đã ignore).
# Cổng 8080 trùng gateway trong Docker: `npm run dev:infra` đã dừng container api-gateway.
PORT=8080
JWT_SECRET=dev-access-secret
INTERNAL_API_TOKEN=dev-internal-token
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
IDENTITY_SERVICE_URL=http://127.0.0.1:3001
CATALOG_SERVICE_URL=http://127.0.0.1:3002
PROMOTION_SERVICE_URL=http://127.0.0.1:3003
# Chưa có service: không có gì lắng nghe → gateway trả 503 NT-GW-0503
ORDER_SERVICE_URL=http://127.0.0.1:3004
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3006
ASSISTANT_SERVICE_URL=http://127.0.0.1:3007
HTTP_TIMEOUT_MS=2000
PROXY_TIMEOUT_MS=10000
PROXY_TIMEOUT_AI_MS=80000
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=30
RATE_LIMIT_AI_PER_MIN=20
RESILIENCE_ENABLED=true
